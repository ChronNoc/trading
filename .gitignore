bookmap_addon_java/.gradle/
bookmap_addon_java/build/
data/prototype/prototype.lock
data/discovery/.last_search_run

# Automatic research service runtime state (checkpoints, claims, job results)
data/research_state/

# Generated ML datasets, attempts, challengers, and registry records.
# Source/config/docs are tracked; local trained artifacts and data are not.
data/models/

# Execution gateway runtime logs (paper + demo order/discrepancy logs)
data/execution_state/

# Simulated paper trade ledgers are user-owned trading records, never committed
data/paper/

# Test temp trees must never be tracked (regression-guarded in tests)
pytest-clean-*/
.pytest-tmp/
.pytest-tmp2/
.pytest-tmp-*/

# Temporary work directories
.tmp/

# Claude Code and Serena tool directories
.claude/
.qoder/
.serena/

# Rendered GUI screenshots (regenerate: python -m tools.capture_gui_screenshots)
reports/screenshots/

# Ephemeral per-session build-status logs (timestamp/traceback churn on every
# rebuild; the meaningful outputs - *.build.json, *.decisions.jsonl,
# *.episodes.jsonl, data/labels/*.labels.jsonl - are tracked, this log is not).
data/processed/*.buildstatus.json

# Process-isolation runtime files (PID lock, heartbeats, stop requests).
# Anchored to the repo root: app/runtime/ is source code and must stay tracked.
/runtime/

# Local Telegram alert launcher (contains your bot token/chat id - NEVER commit).
/start_with_alerts.ps1
v/

# Oversized per-session decision logs (8.8MB/106MB) regenerable via
# `python -m tools.build_real_episodes`; committing them would bloat repo
# history far beyond the ~65KB precedent for this file type.
data/processed/session_20260721T131608Z.decisions.jsonl
data/processed/session_20260723T134503Z.decisions.jsonl


# Graphify architecture graph cache and generated output (regenerate: graphify update .)
graphify-out/
